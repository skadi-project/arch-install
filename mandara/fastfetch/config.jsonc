// By jan-rex
// Modified from: https://github.com/fastfetch-cli/fastfetch/discussions/1269
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "padding": {
        "top": 2
      }
    },
    "display": {
      "separator": ""
    },
    "modules": [
      // CUSTOM - Top UI bar
      {
        "type": "custom",
        "key": "{#90}╭─────────────╮",
        "format": "{#90}╭───────────────────────────────"
      },
      {
        "type": "title",
        "key": "{#90}│ {#92}User        {#90}│",
        "format": "{#90}│ {user-name}"
      },
      {
        "type": "datetime",
        "key": "{#90}│ {#92}Datetime    {#90}│",
        "format": "{#90}│ {year}-{month-pretty}-{day-in-month} {hour-pretty}:{minute-pretty}:{second-pretty}"
      },
      {
        "type": "title",
        "key": "{#90}│ {#93}Host        {#90}│",
        "format": "{#90}│ {host-name}"
      },
      {
        "type": "host",
        "key": "{#90}│ {#93}Machine     {#90}│",
        "format": "{#90}│ {name}  {#2}{version}"
      },
      {
        "type": "os",
        "key": "{#90}│ {#93}OS          {#90}│",
        "format": "{#90}│ {name}"
      },
      {
        "type": "kernel",
        "key": "{#90}│ {#93}Kernel      {#90}│",
        "format": "{#90}│ {sysname}  {#2}[v{release}]"
      },
      {
        "type": "uptime",
        "key": "{#90}│ {#93}Uptime      {#90}│",
        "format": "{#90}│ {?days}{days} Days + {?}{hours}:{minutes}:{seconds}"
      },
      {
        "type": "cpu",
        "key": "{#90}│ {#91}CPU         {#90}│",
        "showPeCoreCount": true,
        "temp": true,
        "format": "{#90}│ {name}"
      },
      {
        "type": "gpu",
        "key": "{#90}│ {#91}GPU         {#90}│",
        "detectionMethod": "auto",
        "driverSpecific": true,
        "format": "{#90}│ {name}"
      },
      {
        "type": "memory",
        "key": "{#90}│ {#91}Memory      {#90}│",
        "format": "{#90}│ {used} / {total} ({percentage})"
      },
      {
        "type": "disk",
        "key": "{#90}│ {#91}Disk        {#90}│",
        "format": "{#90}│ {size-used} / {size-total} ({size-percentage})"
      },
      {
        "type": "poweradapter",
        "key": "{#90}│ {#91}Power       {#90}│",
        "format": "{#90}│ {name}"
      },
      {
        "type": "terminal",
        "key": "{#90}│ {#95}Terminal    {#90}│",
        "format": "{#90}│ {pretty-name}"
      },
      {
        "type": "shell",
        "key": "{#90}│ {#95}Shell       {#90}│",
        "format": "{#90}│ {pretty-name}"
      },
      // CUSTOM - Button UI bar
      {
        "type": "custom",
        "key": "{#90}╰─────────────╯",
        "format": "{#90}╰───────────────────────────────"
      }
    ]
  }
